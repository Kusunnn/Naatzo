# Servidor
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173
JWT_SECRET=cambia-esto-por-un-secreto-largo
JWT_EXPIRES_IN=7d
# URL del frontend; el Notificador la usa para armar el link del tablero
FRONTEND_URL=http://localhost:5173
# URL publica de esta API; se usa para el link de descarga del ZIP
API_PUBLIC_URL=http://localhost:4000

# Base de datos (Supabase, Session Pooler)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/naatzo
DATABASE_SSL=true
# Esquema donde viven las tablas. Usa "naatzo" si compartes el Supabase de KIBO 1.
DB_SCHEMA=public

# Modelos
# gemini | mock. Si LLM_API_KEY esta vacia se usa mock automaticamente.
LLM_PROVIDER=gemini
# Llave de Google AI Studio (se manda en el header x-goog-api-key)
LLM_API_KEY=
# Analista, Notificador, README
LLM_MODEL_FAST=gemini-3.5-flash-lite
# Planificador
LLM_MODEL_SMART=gemini-3.8-flash
FALLBACK_PROVIDER=groq
GROQ_API_KEY=

# Modo agente del DevOps (opcional, despues del MVP)
DEVOPS_AGENT_MODE=off
GEMINI_AGENT_ID=antigravity-preview-09-2026

# GitHub
GITHUB_TOKEN=
GITHUB_OWNER=naatzo-demo
# org | user
GITHUB_OWNER_TYPE=org

# Jira (opcional, despues del MVP). El tablero es propio: no se usa Trello.
JIRA_BASE_URL=https://tu-sitio.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# Avisos por correo (SMTP). Si SMTP_HOST queda vacio, los avisos se guardan
# en el historial para mostrarlos en pantalla.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=tu correo y
# SMTP_PASS=una contrasena de aplicacion (no tu contrasena normal).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Remitente; si queda vacio se usa "Naatzo <SMTP_USER>"
SMTP_FROM=

# Otros
# 32 bytes en base64 para cifrar tokens guardados
ENCRYPTION_KEY=
RISK_CHECK_CRON=*/10 * * * *
DEMO_MODE=true
WORKSPACE_DIR=./workspace
