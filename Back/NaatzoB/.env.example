PORT=4000
CHATBOT_SERVICE_URL=http://localhost:3000
NODE_ENV=development

# Base local de pruebas (ajusta el usuario de PostgreSQL)
DATABASE_URL=postgresql://localhost:5432/naatzo_local
DATABASE_SSL=false

# Módulo de equipos, integrado bajo /api/team en el mismo puerto.
# No usar public: sus tablas y usuarios son distintos de los individuales.
TEAM_DB_SCHEMA=naatzo_team
# Configura una clave aleatoria de al menos 32 caracteres (obligatoria en producción).
TEAM_JWT_SECRET=
